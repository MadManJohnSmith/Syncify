# Syncify Environment Configuration Example (TASK-94 / SEC-010)
# DEVELOPMENT ONLY: .env is loaded exclusively in development runs — debug
# builds of the app, or SYNCIFY_ENV=development when running the Python
# bridges standalone. Release builds never read .env; configure credentials
# in the UI/keyring or via real OS environment variables.
# Copy this file to .env and fill in your credentials.
# NEVER commit real API secrets or private tokens to version control.
#
# NOTE: the app database path is derived from the OS app-data directory
# (src-tauri/src/db.rs); there is no DATABASE_URL override.

# Spotify Web API credentials (read by src-tauri/src/services/spotify.rs).
# SPOTIPY_* are accepted as fallback aliases.
# Register application at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Spotify lyrics fallback: cookie value of the logged-in session ("sp_dc").
# Read by src-tauri/src/download/lyrics.rs and scripts/auth_bridge.py.
SPOTIFY_SP_DC=your_sp_dc_cookie_here

# Qobuz (optional - can also use browser auth or secure UI credentials)
QOBUZ_APP_ID=your_qobuz_app_id_here
QOBUZ_APP_SECRET=your_qobuz_app_secret_here

# Qobuz user auth fallbacks (read by src-tauri/src/download/qobuz.rs,
# src-tauri/src/main.rs, src-tauri/src/commands/auth.rs and
# src-tauri/src/commands/service.rs). Either QOBUZ_USER_TOKEN alone, or
# QOBUZ_USERNAME/QOBUZ_EMAIL + QOBUZ_PASSWORD.
QOBUZ_USER_TOKEN=your_qobuz_user_token_here
QOBUZ_USERNAME=your_qobuz_username_here
QOBUZ_EMAIL=your_qobuz_email_here
QOBUZ_PASSWORD=your_qobuz_password_here

# Deezer (ARL manual cookie token and optional Blowfish track decryption key)
DEEZER_ARL=your_deezer_arl_here
DEEZER_BLOWFISH_KEY=your_deezer_blowfish_key_here

# SoundCloud OAuth token
SOUNDCLOUD_AUTH_TOKEN=your_soundcloud_token_here

# Last.fm (optional - for scrobbling)
LASTFM_API_KEY=your_lastfm_api_key_here

# Tidal. User authentication is by access token (device/refresh flow via the UI
# or this dev fallback).
TIDAL_ACCESS_TOKEN=your_tidal_access_token_here

# Tidal client credentials: required by the Python Tidal device-code flow
# (scripts/services/tidal_auth.py, scripts/services/tidal_service.py) and used as
# an env fallback by the syncify-tidal-downloader crate
# (crates/syncify-tidal-downloader/src/lib.rs) when no client credentials are
# stored in the database. The crate falls back to built-in development
# placeholders when they are missing; the Python bridges fail with an explicit
# error instead of embedding credentials.
TIDAL_CLIENT_ID=your_tidal_client_id_here
TIDAL_CLIENT_SECRET=your_tidal_client_secret_here

# Tidal client id of the public PKCE client (Hi-Res / HiFi+), used only by the
# interactive PKCE flow in scripts/services/tidal_service.py. No secret: PKCE
# clients are public.
# TIDAL_CLIENT_ID_PKCE=your_tidal_pkce_client_id_here

# Tidal API base URL override (optional; read by src-tauri/src/commands/service.rs)
# TIDAL_API_BASE_URL=https://openapi.tidal.com/v2

# AcoustID fingerprinting helper binary (optional; read by
# src-tauri/src/services/enrichment.rs). Defaults to "fpcalc" on PATH.
# FPCALC_PATH=/usr/local/bin/fpcalc

# App runtime mode ("development" enables verbose file logging; read by
# src-tauri/src/services/logging.rs).
# SYNCIFY_ENV=development

# Custom log output directory (optional; read by src-tauri/src/services/logging.rs).
# SYNCIFY_LOG_DIR=/var/log/syncify
