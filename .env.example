# Syncify Environment Configuration Example (TASK-94 / SEC-010)
# Copy this file to .env and fill in your credentials.
# Secrets are loaded dynamically via environment variables or configured securely in the UI/keyring.
# NEVER commit real API secrets or private tokens to version control.

# Database
DATABASE_URL=sqlite:./data/syncify.db

# Spotify - Register application at https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Qobuz (optional - can also use browser auth or secure UI credentials)
QOBUZ_APP_ID=your_qobuz_app_id_here
QOBUZ_APP_SECRET=your_qobuz_app_secret_here

# Deezer (ARL manual cookie token and optional Blowfish track decryption key)
DEEZER_ARL=your_deezer_arl_here
DEEZER_BLOWFISH_KEY=your_deezer_blowfish_key_here

# SoundCloud OAuth token
SOUNDCLOUD_AUTH_TOKEN=your_soundcloud_token_here

# Last.fm (optional - for scrobbling)
LASTFM_API_KEY=your_lastfm_api_key_here

# Tidal (optional - can also use device authorization or secure UI credentials)
TIDAL_CLIENT_ID=your_tidal_client_id_here
TIDAL_CLIENT_SECRET=your_tidal_client_secret_here
TIDAL_ACCESS_TOKEN=your_tidal_access_token_here
