# Syncify Environment Configuration
# Copy this file to .env and fill in your credentials

# Database
DATABASE_URL=sqlite:./data/syncify.db

# Spotify - Get from https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Qobuz (optional - can also use browser auth)
QOBUZ_APP_ID=
QOBUZ_APP_SECRET=

# Deezer ARL (manual extraction from browser cookies)
DEEZER_ARL=

# SoundCloud OAuth token
SOUNDCLOUD_AUTH_TOKEN=

# Last.fm (optional - for scrobbling)
LASTFM_API_KEY=

# Tidal (optional - can also use browser auth)
TIDAL_ACCESS_TOKEN=
